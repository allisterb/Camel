<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>False</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Allister Beharry</Authors>
    <Company />
    <Product>Camel</Product>
    <PackageProjectUrl>https://github.com/allisterb/Camel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/allisterb/Camel</RepositoryUrl>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Camel.Environments\Camel.Environments.csproj" />
    <ProjectReference Include="..\Camel.Runtime\Camel.Runtime.csproj" />
    <ProjectReference Include="..\Camel.Server\Camel.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
  </ItemGroup>

  <!-- Case-scaffolding templates emitted by the `create-case` verb. Embedded so they travel inside the
       assembly regardless of the working directory. LogicalName is the manifest resource name. -->
  <ItemGroup>
    <EmbeddedResource Include="CaseTemplate\CLAUDE.md" LogicalName="Camel.CLI.CaseTemplate.CLAUDE.md" />
    <EmbeddedResource Include="CaseTemplate\mcp.json" LogicalName="Camel.CLI.CaseTemplate.mcp.json" />
    <EmbeddedResource Include="CaseTemplate\settings.json" LogicalName="Camel.CLI.CaseTemplate.settings.json" />
    <EmbeddedResource Include="CaseTemplate\report.html" LogicalName="Camel.CLI.CaseTemplate.report.html" />
    <EmbeddedResource Include="CaseTemplate\report.js" LogicalName="Camel.CLI.CaseTemplate.report.js" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


</Project>
