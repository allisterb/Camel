				"Sudo": true
			},
			"MakeMountDir": {
				"Description": "Create a mount-point subdirectory under /mnt (sudo)",
				"Command": "/usr/bin/mkdir",
				"Sudo": true
			},
			"Unmount": {
				"Description": "Unmount a mounted filesystem or device (umount)",
				"Command": "/usr/bin/umount",
				"Sudo": true
			},
			"ImgStat": {
				"Description": "Display image format and sector size",
				"Command": "/bin/img_stat",
				"Sudo": false
			},
			"Mmls": {
				"Description": "Display partition table (MBR and GPT)",
				"Command": "/bin/mmls",
				"Sudo": true
			},
			"FsStat": {
				"Description": "Filesystem metadata (cluster size, MFT location, etc.)",
				"Command": "/bin/fsstat",
				"Sudo": true
			},
			"Fls": {
				"Description": "List files and directories (includes deleted entries)",
