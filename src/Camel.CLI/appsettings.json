				"Command": "/bin/istat",
				"Sudo": true
			},
			"Ffind": {
				"Description": "Find filename for an inode",
				"Command": "/bin/ffind",
				"Sudo": true
			},
			"Ils": {
				"Description": "List inodes (including orphan/deleted)",
				"Command": "/bin/ils",
				"Sudo": true
			},
			"Blkls": {
				"Description": "Extract unallocated disk blocks (for carving)",
				"Command": "/bin/blkls",
				"Sudo": true
			},
			"TskRecover": {
				"Description": "Bulk extract all allocated and/or unallocated files",
				"Command": "/bin/tsk_recover",
				"Sudo": true
			},
			"Mactime": {
				"Description": "Generate timeline from bodyfile",
				"Command": "/bin/mactime",
				"Sudo": false
			},
			"Blkcat": {
				"Description": "Extract raw data unit content",
				"Command": "/bin/blkcat",
				"Sudo": true
			},
			"BulkExtractor": {
				"Description": "Carve email addresses, URLs, domains, credit cards, etc.",
				"Command": "/bin/bulk_extractor",
				"Sudo": true
			},
			"PhotoRec": {
				"Description": "File carving by file signature",
				"Command": "/bin/photorec",
				"Sudo": true
			}
		},
