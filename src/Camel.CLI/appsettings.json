{
	"SIFT": {
		"Environment": "Ssh",
		"Host": "<sans-host>",
		"Port": 22,
		"User": "<sans-user>",
		"Password": "<sans-pw>"
	},
	"Kali": {
		"Environment": "Ssh",
		"Host": "<kali-host>",
		"Port": 22,
		"User": "<kali-user>",
		"Password": "<kali-pw>",
		"Tools": {
			"Recon": {
				"Whois": { "Description": "Domain registration (registrar/dates/nameservers/contacts)", "Command": "/usr/bin/whois", "Sudo": false },
				"DnsRecon": { "Description": "DNS enumeration: std records, crt.sh/brute subdomains, AXFR zone transfer (JSON via -j)", "Command": "/usr/bin/dnsrecon", "Sudo": false },
				"WhatWeb": { "Description": "Web technology/server/title fingerprinting (JSON via --log-json)", "Command": "/usr/bin/whatweb", "Sudo": false },
				"Wafw00f": { "Description": "Web Application Firewall fingerprinting (JSON via -f json)", "Command": "/usr/bin/wafw00f", "Sudo": false },
				"TheHarvester": { "Description": "OSINT harvesting of emails/hosts/IPs from third-party sources (JSON via -f)", "Command": "/usr/bin/theHarvester", "Sudo": false }
			},
			"Scanning": {
				"Nmap": { "Description": "Port/service/OS scanner (-sV/-O), XML output (-oX -)", "Command": "/usr/bin/nmap", "Sudo": true },
				"Masscan": { "Description": "Asynchronous mass TCP port scanner (fast, port-only)", "Command": "/usr/bin/masscan", "Sudo": true }
			},
			"VulnScan": {
				"Nmap": { "Description": "NSE vulnerability scripts (--script vuln,vulners), XML output (-oX -)", "Command": "/usr/bin/nmap", "Sudo": true },
				"Nikto": { "Description": "Web server vulnerability/misconfiguration scanner (stdout parsed)", "Command": "/usr/bin/nikto", "Sudo": false },
				"Nuclei": { "Description": "Template-based vulnerability scanner (JSONL via -jsonl); optional", "Command": "/usr/bin/nuclei", "Sudo": false }
			},
			"WebApp": {
				"Gobuster": { "Description": "Directory/file content discovery brute-force (dir mode, -q stdout)", "Command": "/usr/bin/gobuster", "Sudo": false },
				"Wpscan": { "Description": "WordPress enumeration: core/plugin/theme versions, vulns, users (JSON via -o)", "Command": "/usr/bin/wpscan", "Sudo": false },
				"Sqlmap": { "Description": "Automated SQL-injection testing (--batch); Exploit-class activity", "Command": "/usr/bin/sqlmap", "Sudo": false }
			},
			"Passwords": {
				"Hydra": { "Description": "Online password guessing against services (ssh/ftp/mysql/...); CredentialAttack", "Command": "/usr/bin/hydra", "Sudo": false },
				"Medusa": { "Description": "Online password guessing (hydra alternative)", "Command": "/usr/bin/medusa", "Sudo": false },
				"Hashcat": { "Description": "Offline hash cracking (GPU); needs OpenCL runtime", "Command": "/usr/bin/hashcat", "Sudo": false },
				"John": { "Description": "Offline hash cracking (CPU); reliable fallback", "Command": "/usr/sbin/john", "Sudo": false }
			},
			"Metasploit": {
				"Msfrpcd": { "Description": "Metasploit RPC daemon (msgpack/HTTP); module search/info/execute + stateful session management", "Command": "/usr/bin/msfrpcd", "Sudo": false, "Host": "127.0.0.1", "Port": "55553", "User": "msf", "Password": "camel" }
			}
		}
	},
	"PenTest": {
		"DefaultMaxPacketRate": 1000,
		"DefaultMaxConcurrentTargets": 16
	},
	"KnowledgeBases": {
		"nvd": {
			"BaseUrl": "https://services.nvd.nist.gov/rest/json/",
			"Auth": "Header", "AuthName": "apiKey", "KeyRef": "NVD_API_KEY", "KeyRequired": false,
			"RateLimitPerMinute": 50, "CacheTtlMinutes": 1440, "DisclosesTarget": false
		},
		"cisa-kev": {
			"BaseUrl": "https://www.cisa.gov/sites/default/files/feeds/",
			"Auth": "None", "CacheTtlMinutes": 1440, "DisclosesTarget": false
		},
		"epss": {
			"BaseUrl": "https://api.first.org/data/v1/",
			"Auth": "None", "RateLimitPerMinute": 60, "CacheTtlMinutes": 720, "DisclosesTarget": false
		},
		"exploitdb": {
			"Transport": "Cli", "Command": "searchsploit", "CacheTtlMinutes": 60, "DisclosesTarget": false
		},
		"osv": {
			"BaseUrl": "https://api.osv.dev/",
			"Auth": "None", "RateLimitPerMinute": 60, "CacheTtlMinutes": 720, "DisclosesTarget": false
		},
		"shodan": {
			"BaseUrl": "https://api.shodan.io/",
			"Auth": "QueryParam", "AuthName": "key", "KeyRef": "SHODAN_API_KEY", "KeyRequired": true,
			"RateLimitPerMinute": 60, "CacheTtlMinutes": 60, "DisclosesTarget": true
		}
	},
	"Tools": {
		"PacketAnalysis": {
			"Tcpdump": { "Description": "Read/filter/print packets from a pcap (BPF)", "Command": "/usr/bin/tcpdump", "Sudo": false },
			"Tshark": { "Description": "Wireshark CLI: dissection, -z statistics, -T fields, --export-objects", "Command": "/usr/bin/tshark", "Sudo": false },
			"Capinfos": { "Description": "Capture-file metadata (packets/bytes/duration/hashes)", "Command": "/usr/bin/capinfos", "Sudo": false },
			"Editcap": { "Description": "Slice/split/time-window a capture file", "Command": "/usr/bin/editcap", "Sudo": false },
			"Mergecap": { "Description": "Merge multiple capture files", "Command": "/usr/bin/mergecap", "Sudo": false },
			"Tcpflow": { "Description": "Reassemble TCP flows to files", "Command": "/usr/bin/tcpflow", "Sudo": false },
			"Tcptrace": { "Description": "Per-connection TCP statistics", "Command": "/usr/bin/tcptrace", "Sudo": false },
			"Ngrep": { "Description": "Regex search of packet payloads", "Command": "/usr/bin/ngrep", "Sudo": false },
			"Nfdump": { "Description": "Read/filter NetFlow (nfcapd) records", "Command": "/usr/bin/nfdump", "Sudo": false },
			"P0f": { "Description": "Passive OS/device fingerprinting from a pcap", "Command": "/usr/sbin/p0f", "Sudo": false },
			"Suricata": { "Description": "Signature IDS over a pcap (eve.json alerts)", "Command": "/usr/bin/suricata", "Sudo": false }
		},
		"LinuxAnalysis": {
			"Last": {
				"Description": "List successful logins/logouts from a wtmp file (last -F -i -w -f)",
				"Command": "/usr/bin/last",
				"Sudo": true
			},
			"Lastb": {
				"Description": "List failed login attempts from a btmp file (lastb -F -i -w -f)",
				"Command": "/usr/bin/lastb",
				"Sudo": true
			},
			"Utmpdump": {
				"Description": "Dump raw utmp/wtmp/btmp records in structured form",
				"Command": "/usr/bin/utmpdump",
				"Sudo": true
			},
			"Journalctl": {
				"Description": "Read the systemd journal from a mounted journal directory (journalctl -D -o json)",
				"Command": "/usr/bin/journalctl",
				"Sudo": true
			},
			"ClamScan": {
				"Description": "ClamAV on-demand malware scanner (clamscan -r -i)",
				"Command": "/usr/bin/clamscan",
				"Sudo": true
			}
		},
		"MemoryAnalysis": {
			"Volatility3": {
				"Description": "Volatility 3 memory forensics framework",
				"Command": " /opt/volatility3/bin/vol",
				"Sudo" : true
			}
		},
		"DiskAnalysis": {
			"Foremost": { "Description": "Signature-based file carving (foremost)", "Command": "/usr/bin/foremost", "Sudo": true },
			"Scalpel": { "Description": "Signature-based file carving (scalpel)", "Command": "/usr/bin/scalpel", "Sudo": true },
			"Sigfind": { "Description": "Find a byte signature's block offsets in an image", "Command": "/usr/bin/sigfind", "Sudo": true },
			"Extundelete": { "Description": "Undelete files from an ext3/ext4 image", "Command": "/usr/bin/extundelete", "Sudo": true },
			"BdeInfo": { "Description": "Read BitLocker (BDE) volume metadata and key protectors (bdeinfo)", "Command": "/usr/bin/bdeinfo", "Sudo": true },
			"BdeMount": { "Description": "Unlock and mount a BitLocker (BDE) volume, exposing the decrypted bde1 device (bdemount)", "Command": "/usr/bin/bdemount", "Sudo": true },
