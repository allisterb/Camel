<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.9.2" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
  </ItemGroup>

  <!-- Embed the Camel JS SDK reference docs so the MCP resource handlers can serve them
       regardless of the server's working directory. LogicalName is the manifest resource name. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\Camel.core.md" LogicalName="Camel.core.md" />
    <EmbeddedResource Include="..\..\docs\Camel.schema.md" LogicalName="Camel.schema.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Camel.Environments\Camel.Environments.csproj" />
    <ProjectReference Include="..\Camel.Runtime\Camel.Runtime.csproj" />
    <ProjectReference Include="..\Camel.Toolkits\Camel.Toolkits.csproj" />
    <ProjectReference Include="..\Camel.Inference\Camel.Inference.csproj" />
    <ProjectReference Include="..\Camel.Workflows\Camel.Workflows.csproj" />
  </ItemGroup>

</Project>
